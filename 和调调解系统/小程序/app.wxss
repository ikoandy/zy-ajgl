/* ================================
   和调 · 微信小程序全局样式
   配色继承PC端：金色主调 #c9a84c
   ================================ */

page {
  --gold: #c9a84c;
  --gold-light: #e4c76a;
  --gold-dim: rgba(201, 168, 76, 0.12);
  --teal: #2dd4bf;
  --teal-dim: rgba(45, 212, 191, 0.10);
  --rose: #f472b6;
  --rose-dim: rgba(244, 114, 182, 0.10);
  --violet: #a78bfa;
  --violet-dim: rgba(167, 139, 250, 0.10);
  --dark: #070b14;
  --dark-sec: #0d1321;
  --text-primary: #1a1a2e;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --bg-page: #f5f6f8;
  --bg-card: #ffffff;
  --border: #eef0f3;
  --border-light: #f3f4f6;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg-page);
  font-size: 28rpx;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ---- 通用容器 ---- */
.container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---- 卡片 ---- */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ---- 状态标签 ---- */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.status-pending { background: var(--gold-dim); color: var(--gold); }
.status-accepted { background: rgba(96,165,250,0.12); color: #60a5fa; }
.status-mediating { background: var(--teal-dim); color: var(--teal); }
.status-agreed { background: rgba(52,211,153,0.12); color: #34d399; }
.status-terminated { background: var(--rose-dim); color: var(--rose); }
.status-closed { background: var(--violet-dim); color: var(--violet); }

/* ---- 统计数字 ---- */
.stat-number {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1rpx;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* ---- 按钮体系 ---- */
.btn-gold {
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-gold::after { border: none; }

.btn-outline {
  background: transparent;
  color: var(--gold);
  border: 2rpx solid var(--gold);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}
.btn-outline::after { border: none; }

/* ---- 列表项 ---- */
.list-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
}
.list-item:last-child { border-bottom: none; }
.list-item:active { background: #fafafa; }

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-state-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.25;
  margin-bottom: 24rpx;
}
.empty-state-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* ---- 分割线 ---- */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* ---- 安全区域底部 ---- */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
