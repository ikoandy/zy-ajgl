.page { display: flex; flex-direction: column; height: 100vh; }

/* ---- 搜索栏 ---- */
.search-bar {
  padding: 20rpx 32rpx;
  background: var(--bg-card);
}
.search-input-wrap {
  display: flex; align-items: center;
  background: var(--bg-page);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 76rpx;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; height: 76rpx; color: var(--text-primary); }
.ph { color: var(--text-muted); }
.search-clear { padding: 8rpx 16rpx; color: var(--text-muted); font-size: 26rpx; }

/* ---- 状态筛选 ---- */
.filter-scroll { white-space: nowrap; background: var(--bg-card); border-bottom: 1rpx solid var(--border); }
.filter-list { display: inline-flex; padding: 16rpx 24rpx; gap: 16rpx; }
.filter-item {
  display: inline-flex; align-items: center;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  background: var(--bg-page);
  border: 2rpx solid transparent;
  white-space: nowrap;
  transition: all 0.2s;
}
.filter-item.active {
  color: var(--gold);
  background: var(--gold-dim);
  border-color: rgba(201,168,76,0.3);
  font-weight: 600;
}

/* ---- 列表滚动区 ---- */
.case-scroll { flex: 1; overflow: hidden; }

/* ---- 案件卡片 ---- */
.case-list { padding: 0 32rpx; padding-top: 20rpx; }
.case-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.case-card:active { transform: scale(0.98); transition: transform 0.1s; }

.card-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14rpx;
}
.card-left { display: flex; align-items: center; gap: 12rpx; }
.case-no { font-size: 24rpx; color: var(--gold); font-weight: 700; letter-spacing: 0.5rpx; }

.priority-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
}
.priority-urgent { background: var(--rose); box-shadow: 0 0 8rpx rgba(244,114,182,0.5); }
.priority-high { background: #f59e0b; }
.priority-normal { background: transparent; border: 2rpx solid var(--border); }

.card-title {
  font-size: 30rpx; font-weight: 600; color: var(--text-primary);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; line-height: 1.45; margin-bottom: 12rpx;
}
.card-row { display: flex; justify-content: space-between; }
.card-meta { font-size: 23rpx; color: var(--text-muted); }

.card-footer {
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
  font-size: 23rpx; color: var(--text-secondary);
}

/* ---- 加载更多 ---- */
.load-more {
  text-align: center; padding: 28rpx;
  font-size: 24rpx; color: var(--text-muted);
}
