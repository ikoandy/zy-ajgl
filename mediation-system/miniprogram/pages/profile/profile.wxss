.page { padding-bottom: 40rpx; }

/* ---- 头部 ---- */
.profile-header {
  position: relative; padding-top: 80rpx;
  background: linear-gradient(135deg, var(--dark), var(--dark-sec));
  padding-bottom: 48rpx;
}
.profile-bg {
  position: absolute; inset: 0;
  opacity: 0.06;
  background: radial-gradient(circle at 70% 30%, var(--gold) 0%, transparent 60%);
}
.profile-info {
  position: relative; display: flex; flex-direction: column; align-items: center;
  z-index: 1;
}
.avatar-lg {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 44rpx; font-weight: 700;
  border: 4rpx solid rgba(255,255,255,0.15);
  margin-bottom: 16rpx;
}
.user-name { font-size: 36rpx; font-weight: 700; color: #fff; }
.user-role { font-size: 25rpx; color: rgba(255,255,255,0.45); margin-top: 4rpx; }

/* ---- 菜单列表 ---- */
.menu-section {
  margin: -24rpx 32rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative; z-index: 2;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.menu-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #fafafa; }
.menu-icon { font-size: 34rpx; width: 44rpx; text-align: center; }
.menu-text { flex: 1; font-size: 29rpx; color: var(--text-primary); }
.menu-arrow { font-size: 36rpx; color: var(--border); }

/* ---- 统计 ---- */
.stat-section {
  display: flex; justify-content: space-around;
  margin: 0 32rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 32rpx 0;
}
.mini-stat { text-align: center; }
.mini-num { font-size: 40rpx; font-weight: 700; color: var(--gold); display: block; }
.mini-label { font-size: 23rpx; color: var(--text-muted); margin-top: 4rpx; }

/* ---- 登出 ---- */
.logout-btn {
  margin: 8rpx 32rpx !important;
  height: 88rpx !important;
  background: transparent !important;
  color: var(--rose) !important;
  border: 2rpx solid rgba(244,114,182,0.3) !important;
  border-radius: var(--radius-md) !important;
  font-size: 29rpx !important; letter-spacing: 2rpx;
}
.logout-btn::after { border: none; }

/* ---- 版本 ---- */
.version {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--text-muted);
  margin-top: 32rpx;
}
