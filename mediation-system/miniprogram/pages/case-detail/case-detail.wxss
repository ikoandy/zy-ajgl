.page { padding-bottom: 60rpx; background: var(--bg-page); }

/* ---- 顶部状态栏 ---- */
.detail-header {
  background: linear-gradient(135deg, var(--dark), var(--dark-sec));
  padding: 32rpx; padding-top: 24rpx;
}
.header-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.case-no { font-size: 26rpx; color: var(--gold); font-weight: 700; letter-spacing: 0.5rpx; }
.status-lg { padding: 4rpx 18rpx; font-size: 23rpx; }

.case-title {
  font-size: 34rpx; font-weight: 700; color: #fff;
  line-height: 1.4; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; margin-bottom: 12rpx;
}
.header-meta { font-size: 24rpx; color: rgba(255,255,255,0.45); display: flex; gap: 8rpx; }
.meta-dot { color: rgba(255,255,255,0.25); }

/* ---- 操作按钮 ---- */
.action-bar {
  display: flex; justify-content: center; gap: 20rpx;
  padding: 28rpx 32rpx; background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
}
.action-btn {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  background: none !important; border: none !important;
  padding: 8rpx 24rpx; line-height: 1.3;
}
.action-btn::after { border: none; }
.action-icon { font-size: 36rpx; }
.action-btn text:last-child { font-size: 23rpx; color: var(--text-secondary); }

/* ---- 区块 ---- */
.section { margin-top: 24rpx; padding: 0 32rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 20rpx; }
.section-header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }

/* ---- 信息网格 ---- */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.info-item { background: var(--bg-card); border-radius: var(--radius-md); padding: 24rpx; }
.info-label { font-size: 23rpx; color: var(--text-muted); display: block; margin-bottom: 6rpx; }
.info-value { font-size: 28rpx; color: var(--text-primary); font-weight: 600; }
.priority-urgent { color: var(--rose); }
.priority-high { color: #f59e0b; }
.priority-normal { color: var(--text-secondary); }

/* ---- 描述 ---- */
.desc-block { margin-top: 20rpx; background: var(--bg-card); border-radius: var(--radius-md); padding: 28rpx; }
.desc-label { font-size: 23rpx; color: var(--text-muted); display: block; margin-bottom: 10rpx; }
.desc-text { font-size: 27rpx; color: var(--text-secondary); line-height: 1.7; }

/* ---- 当事人 ---- */
.party-card {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 14rpx;
}
.party-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; flex-shrink: 0;
}
.party-info { flex: 1; min-width: 0; }
.party-name-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 6rpx; }
.party-name { font-size: 29rpx; font-weight: 600; color: var(--text-primary); }
.role-tag {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 12rpx; font-weight: 500;
}
.role-plaintiff { background: var(--gold-dim); color: var(--gold); }
.role-defendant { background: var(--teal-dim); color: var(--teal); }
.role-witness { background: var(--violet-dim); color: var(--violet); }
.party-phone { font-size: 24rpx; color: var(--text-muted); }

/* ---- 时间线 ---- */
.timeline { position: relative; padding-left: 40rpx; }
.timeline::before {
  content: ''; position: absolute; left: 13rpx; top: 8rpx; bottom: 8rpx;
  width: 2rpx; background: var(--border);
}
.timeline-item { position: relative; padding-bottom: 32rpx; }
.timeline-item:last-child { padding-bottom: 0; }
.tl-dot {
  position: absolute; left: -33rpx; top: 6rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  border: 3rpx solid var(--bg-page);
}
.tl-body { background: var(--bg-card); border-radius: var(--radius-sm); padding: 20rpx 24rpx; }
.tl-action { font-size: 27rpx; color: var(--text-primary); display: block; }
.tl-time { font-size: 22rpx; color: var(--text-muted); margin-top: 6rpx; display: block; }

/* ---- 加载中 ---- */
.loading-full {
  display: flex; align-items: center; justify-content: center;
  min-height: 60vh; color: var(--text-muted); font-size: 28rpx;
}
